{
  "firestore": {
    "database": "(default)",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": "functions/appearance",
      "codebase": "quartinaut-appearance",
      "ignore": ["node_modules", ".git", "firebase-debug.log"]
    },
    {
      "source": "functions/nativeChats",
      "codebase": "quartinaut-native-chats",
      "ignore": ["node_modules", ".git", "firebase-debug.log"]
    },
    {
      "source": "functions/enhancements",
      "codebase": "quartinaut-enhancements",
      "ignore": ["node_modules", ".git", "firebase-debug.log"]
    }
  ],
  "emulators": {
    "firestore": {"port": 8088},
    "storage": {"port": 9198},
    "ui": {"enabled": false},
    "singleProjectMode": true
  }
}
